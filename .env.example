# --- Serveur uniquement (jamais de préfixe NEXT_PUBLIC sur une clé ou un webhook) ---
#
# Acheminement des demandes du formulaire. Il en faut UN des deux, sinon
# /api/lead renvoie 503 en production et chaque demande est perdue.
#
# 1) Webhook n8n (prioritaire s'il est défini).
N8N_LEAD_WEBHOOK_URL=
# Secret partagé envoyé dans l'en-tête X-Webhook-Secret (à vérifier côté n8n).
N8N_LEAD_WEBHOOK_SECRET=
#
# 2) Envoi direct par e-mail via Resend, utilisé si aucun webhook n'est défini.
# La clé commence par « re_ ». LEAD_EMAIL_FROM doit être sur un domaine vérifié
# dans Resend ; LEAD_EMAIL_TO accepte plusieurs adresses séparées par des virgules.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# --- Build ---
# true = le site peut être indexé par Google. Laisser vide tant que launch-check n'est pas vert.
SITE_INDEXABLE=
SITE_URL=https://la-belle-intendance.fr

# --- Mesure (identifiants publics, chargés seulement après consentement) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
