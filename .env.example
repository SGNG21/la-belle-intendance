# --- Serveur uniquement (jamais de préfixe NEXT_PUBLIC sur une clé ou un webhook) ---
# Webhook n8n qui reçoit les demandes de devis. Sans lui, /api/lead renvoie 503 en production.
N8N_LEAD_WEBHOOK_URL=
# Secret partagé envoyé dans l'en-tête X-Webhook-Secret (à vérifier côté n8n).
N8N_LEAD_WEBHOOK_SECRET=

# --- Build ---
# true = le site peut être indexé par Google. Laisser vide tant que launch-check n'est pas vert.
SITE_INDEXABLE=
SITE_URL=https://labelleintendance.fr

# --- Mesure (identifiants publics, chargés seulement après consentement) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
